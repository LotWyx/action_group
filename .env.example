# Copy to .env and adjust before `docker compose up`. Every value has a
# working default in docker-compose.yml, so this file is only needed when
# you want to change something (e.g. a real JWT secret, or the MAX bot token).

POSTGRES_DB=performance_review
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Sign PR-viewing/session tokens with a real secret outside local dev.
JWT_SECRET=change-me-in-production

# Origins allowed to call the API directly (comma-separated). The bundled
# nginx proxies /api same-origin, so this only matters if something calls
# the backend on :8000 from a different origin.
CORS_ORIGINS=http://localhost:8080

# Optional MAX messenger bot integration (https://dev.max.ru) — leave empty
# to disable notifications entirely; everything else works either way.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_REMINDER_DAYS_AHEAD=3
