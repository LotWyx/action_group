# Copy to .env and adjust before `docker compose up`. Every value has a
# working default in docker-compose.yml, so this file is only needed when
# you want to change something (e.g. a real JWT secret, or the VK bot token).

POSTGRES_DB=performance_review
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Sign PR-viewing/session tokens with a real secret outside local dev.
JWT_SECRET=change-me-in-production

# Origins allowed to call the API directly (comma-separated). The bundled
# nginx proxies /api same-origin, so this only matters if something calls
# the backend on :8000 from a different origin.
CORS_ORIGINS=http://localhost:8080

# Optional VK community (group) bot integration
# (https://dev.vk.com/ru/method/messages.send) — leave empty to disable
# notifications entirely; everything else works either way.
VK_BOT_TOKEN=
VK_API_VERSION=5.199
VK_REMINDER_DAYS_AHEAD=3

# Optional GigaChat integration (https://developers.sber.ru/docs/ru/gigachat) —
# free-tier Russian LLM behind the "AI-анализ" buttons. Leave empty to disable;
# every other feature works either way. Get the auth key from your GigaChat
# project's "Авторизационные данные" page (already base64-encoded).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
